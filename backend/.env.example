# Firebase Service Account Key dosyasının yolu
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Sunucu Portu
PORT=5001

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 — ürün görselleri ve şube menü JSON'ları
# Lokalde boş bırakılırsa görsel yükleme ve menü JSON yazımı çalışmaz
# (Firestore işlemleri etkilenmez). Cloudflare Dashboard → R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
