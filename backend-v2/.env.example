# ─── Supabase ───
SUPABASE_URL=https://<proje-ref>.supabase.co
# Panel → Project Settings → API Keys → service_role (secret). RLS'i baypas eder,
# ASLA frontend'e / repoya girmez.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase (Faz 1'de yalnızca Auth doğrulaması için) ───
# Lokalde eski backend'in service account anahtarını kullanır.
GOOGLE_APPLICATION_CREDENTIALS=../backend/serviceAccountKey.json

# ─── Sunucu ───
# Eski backend 5001'de; ikisi yan yana koşabilsin diye v2 5002'de.
PORT=5002

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# ─── Cloudflare R2 — ürün görselleri ve şube menü JSON'ları ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Zamanlanmış çekim ───
# v2'de paralel yayın boyunca kapalı (eski cron ile çift çekim olmasın).
CRON_AKTIF=false

# Menü JSON R2 öneki — paralel yayın boyunca canlı menu/ dosyaları EZİLMESİN.
# Geçiş gecesinde (G11) "menu" yapılır.
MENU_R2_PREFIX=menu-v2
