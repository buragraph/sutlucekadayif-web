---
// Build anında hesaplanır — her yayında güncel kalır
const yil = new Date().getFullYear();
---

<footer class="mt-12 border-t border-ink/10 bg-cream">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 md:grid-cols-3">
    <!-- Marka -->
    <div>
      <img src="/img/logo.png" alt="Sütlüce Kadayıf" class="h-14 w-auto" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed">
        Türkiye'nin ilk soğuk kadayıf markası. Geleneksel lezzeti modern bir
        zarafetle buluşturuyoruz.
      </p>
    </div>

    <!-- İletişim -->
    <div>
      <h4 class="text-lg text-ink">İletişim</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="mailto:info@sutlucekadayif.com" class="hover:text-brand">info@sutlucekadayif.com</a></li>
        <li><a href="tel:08503049722" class="hover:text-brand">0850 304 9722</a></li>
      </ul>
      <h4 class="mt-6 text-lg text-ink">Bizi Takip Edin</h4>
      <ul class="mt-3 flex gap-4 text-sm">
        <li><a href="https://instagram.com/sutlucekadayif" target="_blank" rel="noopener" class="hover:text-brand">Instagram</a></li>
        <li><a href="https://tiktok.com/@sutlucekadayif" target="_blank" rel="noopener" class="hover:text-brand">TikTok</a></li>
        <li><a href="https://youtube.com/@sutlucekadayif" target="_blank" rel="noopener" class="hover:text-brand">YouTube</a></li>
      </ul>
    </div>

    <!-- Bağlantılar -->
    <div>
      <h4 class="text-lg text-ink">Menü</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/urunlerimiz" class="hover:text-brand">Ürünlerimiz</a></li>
        <li><a href="/lezzet-duraklarimiz" class="hover:text-brand">Lezzet Durakları</a></li>
        <li><a href="/hakkimizda" class="hover:text-brand">Hakkımızda</a></li>
        <li><a href="/franchise" class="hover:text-brand">Franchise</a></li>
        <li><a href="/kullanim-kosullari" class="hover:text-brand">Kullanım Koşulları</a></li>
        <li><a href="/gizlilik-politikasi" class="hover:text-brand">Gizlilik Politikası</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink/10">
    <p class="mx-auto max-w-7xl px-6 py-6 text-center text-xs text-body/70">
      © Sütlüce Kadayıf {yil}. Tüm hakları saklıdır.
    </p>
  </div>
</footer>
