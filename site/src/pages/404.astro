---
import Layout from '../layouts/Layout.astro';

/**
 * Bulunamayan sayfa.
 *
 * NEDEN GEREKLİ: `wrangler.jsonc` → `not_found_handling: "none"` bilinmeyen yolda
 * GERÇEK 404 döndürüyor (SPA yedeği yok, doğru karar). Ama 404.html olmadığı
 * için gövde bomboş geliyordu — ziyaretçi beyaz ekran görüyordu.
 *
 * ALAN ADI DEVRİNDE ÖNEMLİ: eski WordPress sitesinin adresleri (arama
 * sonuçlarında, Instagram biyografisinde, basılı malzemede) yeni sitede birebir
 * karşılık bulmuyor. Devirden sonra o bağlantıların hepsi buraya düşecek;
 * buradan devam edilebilecek yolları göstermek gerekiyor.
 *
 * Astro `not_found_handling` ne olursa olsun bu dosyayı `dist/404.html` olarak
 * üretir; Workers statik varlıkları 404'te onu servis eder.
 */
const yollar = [
  { t: 'Ana Sayfa', href: '/', a: 'Markanın hikâyesi ve öne çıkanlar' },
  { t: 'Ürünlerimiz', href: '/urunlerimiz', a: 'Soğuk kadayıf ve diğer tatlılar' },
  { t: 'Lezzet Duraklarımız', href: '/lezzet-duraklarimiz', a: 'Size en yakın şube' },
  { t: 'Franchise', href: '/franchise', a: 'Bayilik başvurusu ve koşullar' },
];
---

<Layout
  title="Sayfa bulunamadı – Sütlüce Kadayıf"
  description="Aradığınız sayfa taşınmış ya da kaldırılmış olabilir."
>
  <section class="mx-auto max-w-3xl px-6 py-20 text-center lg:py-28">
    <p class="font-serif text-6xl text-brand lg:text-7xl">404</p>
    <h1 class="mt-4 text-3xl lg:text-4xl">Bu sayfayı bulamadık</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed">
      Aradığınız sayfa taşınmış, adı değişmiş ya da hiç var olmamış olabilir.
      Aşağıdan devam edebilirsiniz.
    </p>

    <ul class="mx-auto mt-10 grid max-w-2xl gap-3 text-left sm:grid-cols-2">
      {yollar.map((y) => (
        <li>
          <a
            href={y.href}
            class="block h-full rounded-2xl border border-ink/10 bg-white/60 px-5 py-4 transition-colors hover:border-brand/40 hover:bg-white"
          >
            <span class="block font-serif text-lg text-ink">{y.t}</span>
            <span class="mt-1 block text-sm">{y.a}</span>
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/"
      class="mt-10 inline-block rounded-full bg-brand px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
    >
      Ana sayfaya dön
    </a>
  </section>
</Layout>
