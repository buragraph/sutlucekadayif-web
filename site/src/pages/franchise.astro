---
import Layout from '../layouts/Layout.astro';

// İl/ilçe listesi TEK KAYNAKTAN: panel ve sunucu da aynı adları kullanıyor
// (frontend/src/data + backend-v2/shared/iller.js). Burada el yazması bir dizi
// vardı ve "Hakkâri" yazıyordu; diğer iki taraf "Hakkari" kullanıyor. Merkez o
// ili başvuruya kapatsa listeden DÜŞMEZDİ, çünkü adlar tutmuyordu.
import ilIlceData from '../data/tr-iller-ilceler.json';

const iller = Object.keys(ilIlceData).sort((a, b) => a.localeCompare(b, 'tr'));
---

<Layout title="Franchise | Sütlüce Kadayıf">
  <!-- Başlık -->
  <section class="mx-auto max-w-3xl px-6 pt-16 text-center">
    <p class="font-serif text-lg text-brand">Bize Katılın</p>
    <h1 class="mt-2 text-4xl md:text-5xl">Franchise</h1>
    <p class="mt-5 text-lg">Yoğun Franchise talepleriniz için çok teşekkür ederiz! 💚</p>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed">
      Güçlü marka yapımız ve özgün ürün konseptimizle, yatırımcılarımıza
      sürdürülebilir bir iş modeli sunuyoruz. Başarı dolu bir lezzet hikayesinin
      parçası olmak için başvuru formunu doldurun.
    </p>
  </section>

  <!-- Başvuru formu -->
  <section class="mx-auto max-w-2xl px-6 py-14">
    <form
      id="franchise-form"
      class="rounded-3xl border border-ink/10 bg-white/50 p-6 md:p-10"
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="ad" class="mb-1.5 block text-sm font-medium text-ink">Ad</label>
          <input id="ad" name="ad" type="text" required
            class="w-full rounded-xl border border-ink/15 bg-white px-4 py-2.5 outline-none focus:border-brand" />
        </div>
        <div>
          <label for="soyad" class="mb-1.5 block text-sm font-medium text-ink">Soyad</label>
          <input id="soyad" name="soyad" type="text" required
            class="w-full rounded-xl border border-ink/15 bg-white px-4 py-2.5 outline-none focus:border-brand" />
        </div>
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-ink">E-posta</label>
          <input id="email" name="email" type="email" required
            class="w-full rounded-xl border border-ink/15 bg-white px-4 py-2.5 outline-none focus:border-brand" />
        </div>
        <div>
          <label for="telefon" class="mb-1.5 block text-sm font-medium text-ink">Telefon</label>
          <input id="telefon" name="telefon" type="tel" required
            class="w-full rounded-xl border border-ink/15 bg-white px-4 py-2.5 outline-none focus:border-brand" />
        </div>
        <!-- AÇILIR LİSTE MERKEZ AYARINA GÖRE SÜZÜLÜYOR: başvuruya kapatılan
             iller (ör. doygun bölgeler) seçeneklerden çıkarılır. Bkz. aşağıdaki
             script; sunucu da aynı listeyi okuyup kapalı ili reddediyor. -->
        <div>
          <label for="il" class="mb-1.5 block text-sm font-medium text-ink">İl</label>
          <select id="il" name="il" required
            class="w-full rounded-xl border border-ink/15 bg-white px-4 py-2.5 outline-none focus:border-brand">
            <option value="" disabled selected>Seçiniz</option>
            {iller.map((il) => <option value={il}>{il}</option>)}
          </select>
        </div>
        <div>
          <label for="ilce" class="mb-1.5 block text-sm font-medium text-ink">İlçe</label>
          <!-- İLE BAĞLI AÇILIR LİSTE: eskiden serbest metindi ve "kadıköy",
               "Kadikoy", "K.köy" gibi her yazım kaydediliyordu; başvurulardan
               bölge dökümü çıkarmak imkânsızdı. Seçenekler il seçilince
               dolduruluyor (bkz. aşağıdaki script). -->
          <select id="ilce" name="ilce" disabled
            class="w-full rounded-xl border border-ink/15 bg-white px-4 py-2.5 outline-none focus:border-brand disabled:bg-ink/5 disabled:text-ink/40">
            <option value="" selected>Önce il seçin</option>
          </select>
        </div>
      </div>

      <div class="mt-5">
        <label for="mesaj" class="mb-1.5 block text-sm font-medium text-ink">Mesajınız (opsiyonel)</label>
        <textarea id="mesaj" name="mesaj" rows="4"
          class="w-full rounded-xl border border-ink/15 bg-white px-4 py-2.5 outline-none focus:border-brand"></textarea>
      </div>

      <!-- honeypot (bot tuzağı) -->
      <input type="text" name="website" tabindex="-1" autocomplete="off"
        class="absolute left-[-9999px]" aria-hidden="true" />

      <button type="submit"
        class="mt-7 w-full rounded-full bg-brand px-8 py-3 font-semibold text-white transition-colors hover:bg-brand-dark">
        Başvuruyu Gönder
      </button>

      <p id="form-durum" class="mt-4 hidden text-center text-sm"></p>
    </form>
  </section>
</Layout>

<!-- İlçe listesi sayfaya gömülüyor: 973 ilçe ~12 KB, ayrı bir istek atmaya
     değmez ve form ilk açılışta anında çalışır. -->
<script type="application/json" id="ilce-verisi" set:html={JSON.stringify(ilIlceData)}></script>

<script>
  // Franchise başvurusu → CMS backend'i (POST /api/basvurular). Başvuru CMS'te
  // "Franchise Başvuruları" ekranına düşer.
  // YEDEK ADRES CANLI API OLMALI: burada eski Firebase Functions adresi yazıyordu
  // (`api-fyfp72cohq-uc.a.run.app`) ve o fonksiyon SİLİNMİŞTİ. PUBLIC_API_URL
  // derleme ortamında tanımlı olmadığı için yayındaki siteye ölü adres gömülmüş,
  // gönderilen her franchise başvurusu "Failed to fetch" ile kayboluyordu.
  const API_BASE = import.meta.env.PUBLIC_API_URL
    || 'https://sutlucekadayif-api.dijitalreklam.workers.dev/api';

  const form = document.getElementById('franchise-form') as HTMLFormElement | null;
  const ilSecim = document.getElementById('il') as HTMLSelectElement | null;
  const ilceSecim = document.getElementById('ilce') as HTMLSelectElement | null;

  // İl değişince ilçe listesi yeniden kuruluyor; il seçilmeden ilçe kapalı.
  const ilceVerisi: Record<string, string[]> = (() => {
    try { return JSON.parse(document.getElementById('ilce-verisi')?.textContent || '{}'); }
    catch { return {}; }
  })();

  ilSecim?.addEventListener('change', () => {
    if (!ilceSecim) return;
    const ilceler = ilceVerisi[ilSecim.value] || [];
    ilceSecim.innerHTML = '';
    const ilk = document.createElement('option');
    ilk.value = '';
    ilk.textContent = ilceler.length ? 'Seçiniz' : 'Önce il seçin';
    ilceSecim.appendChild(ilk);
    for (const ilce of ilceler) {
      const o = document.createElement('option');
      o.value = ilce;
      o.textContent = ilce;
      ilceSecim.appendChild(o);
    }
    ilceSecim.disabled = ilceler.length === 0;
  });

  // Kapalı iller açılır listeden çıkarılıyor. Site statik olduğu için liste
  // derleme anında değil, sayfa açılışında okunuyor — merkez panelden bir ili
  // kapattığında sitenin yeniden yayınlanması gerekmiyor.
  (async () => {
    try {
      const r = await fetch(`${API_BASE}/basvurular/form-ayarlari`);
      if (!r.ok) return;
      const ayar = await r.json();
      const kapali = new Set(Array.isArray(ayar?.kapaliIller) ? ayar.kapaliIller : []);
      if (kapali.size === 0) return;
      const secim = document.getElementById('il') as HTMLSelectElement | null;
      if (!secim) return;
      for (const secenek of [...secim.options]) {
        if (secenek.value && kapali.has(secenek.value)) secenek.remove();
      }
    } catch { /* ayar okunamazsa tam liste gösterilsin */ }
  })();
  const durum = document.getElementById('form-durum');
  const buton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  function mesajGoster(metin: string, tur: 'basari' | 'hata') {
    if (!durum) return;
    durum.textContent = metin;
    durum.className =
      'mt-4 text-center text-sm ' + (tur === 'basari' ? 'text-brand' : 'text-red-600');
    durum.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('website')) return; // honeypot — bot
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const payload = {
      ad: data.get('ad'),
      soyad: data.get('soyad'),
      email: data.get('email'),
      telefon: data.get('telefon'),
      il: data.get('il'),
      ilce: data.get('ilce'),
      mesaj: data.get('mesaj'),
    };

    if (buton) {
      buton.disabled = true;
      buton.textContent = 'Gönderiliyor...';
    }

    try {
      const res = await fetch(`${API_BASE}/basvurular`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Başvuru gönderilemedi');
      form.reset();
      mesajGoster('Teşekkürler! Başvurunuz alındı, en kısa sürede sizinle iletişime geçeceğiz. 💚', 'basari');
    } catch (err) {
      mesajGoster('Bir sorun oluştu, lütfen daha sonra tekrar deneyin veya bizimle iletişime geçin.', 'hata');
    } finally {
      if (buton) {
        buton.disabled = false;
        buton.textContent = 'Başvuruyu Gönder';
      }
    }
  });
</script>
